# Database (Supabase — get your connection string from supabase.com/dashboard)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key
GOOGLE_API_KEY=your_google_ai_studio_key
DEEPSEEK_API_KEY=your_deepseek_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
OPENAI_API_KEY=sk-your_openai_key

# Authentication  REQUIRED for production
# Generate a strong random key: openssl rand -base64 32
API_KEY=your_secret_api_key_here

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# Proxy & CORS
# Set TRUST_PROXY when behind a reverse proxy (Nginx, Cloudflare, AWS ALB)
# so the rate limiter sees real client IPs instead of the proxy's IP.
# Values: 'loopback', '1', a CIDR range, or leave unset for direct access.
TRUST_PROXY=
CORS_ORIGIN=*

# Server
PORT=3000
NODE_ENV=development

